# =============================================================================
# WP-KMCO knobs (reference)
# Copy to `.env` on a real box and fill site/keys. This tree is not an installer.
# =============================================================================
STATION_ID=WP-KMCO
TZ=America/New_York
ACARSHUB_PORT=8080
IRDM_BEAM_MAP_PORT=8888
IRDM_MT_MAP_PORT=8889

# ADS-B / UAT — git pin is KMCO; real site pin stays in local `.env` only
ADSB_LAT=28.4294
ADSB_LON=-81.3089
ADSB_ALT_M=29
ADSB_MAX_RANGE=450
MLAT_SITE_NAME=WinterPark
ADSB_URL=http://ultrafeeder/data/aircraft.json
MAP_MOBILE_HOST=
ADSB_TAR1090_PORT=8085
ADSB_BEAST_PORT=30005
ADSB_BEAST_IN_PORT=30004
UAT978_PORT=9780
PIAWARE_MAP_PORT=8081
PIAWARE_STAT_PORT=8082
FR24_PORT=8754
PLANEFINDER_PORT=30053

# Radios (locked serial map — see README). Fair game to publish.
AIRSPY_ADSB_SERIAL=0x10A862DC34914863
AIRSPY_ADSB_GAIN=auto
AIRSPY_ADSB_SAMPLE_RATE=20
AIRSPY_ADSB_DX_MODE=true
AIRSPY_ADSB_FEC_BITS=2
UAT_RTL_SERIAL=978
UAT_SDR_GAIN=autogain
UAT_SDR_PPM=0

# Per-site feeder identity — leave empty in git; fill locally
ULTRAFEEDER_UUID=
# Live station has a long community-feed string with per-site UUIDs. Stub:
ULTRAFEEDER_CONFIG=adsb,airspy_adsb,30005,beast_in;adsb,dump978,30978,uat_in

# Commercial feeder credentials — never commit real values
FEEDER_PIAWARE_FEEDER_ID=
FEEDER_FR24_SHARING_KEY=
FEEDER_FR24_UAT_SHARING_KEY=
FEEDER_RADARBOX_SHARING_KEY=
FEEDER_RADARBOX_SN=
FEEDER_OPENSKY_USERNAME=
FEEDER_OPENSKY_SERIAL=
FEEDER_PLANEFINDER_SHARECODE=
FEEDER_PLANEWATCH_API_KEY=
FEEDER_ADSBHUB_STATION_KEY=
FEEDER_SDRMAP_USERNAME=
FEEDER_SDRMAP_PASSWORD=

# =============================================================================
# SDR inventory (locked)
# 35ac63dc2d86554f  Airspy R2     → VHF mux (ka9q) ACARS+VDL2
# 35ac63dc2d8e234f  Airspy Mini   → Iridium 6 MS/s
# 2f52ff5de72635e8  Airspy HF+    → HFDL spare (parked)
# 129               RTL Blog V4   → unused (was VDL2)
# 162               RTL R820T     → AIS
# 402               RTL Blog V4   → radiosonde
# 10A862DC34914863  Airspy Mini   → ADS-B 1090
# 978               RTL           → UAT 978
# =============================================================================

# ── ACARS (host ka9q R2 → acarsdec; docker image parked) ─────────────────────
ACARS_RTL_SERIAL=
ACARS_AIRSPY_SERIAL=35ac63dc2d8e234f
ACARS_SOAPYSDR=
ACARS_GAIN=15
ACARS_FREQUENCIES=129.125 129.350 129.525 130.025 130.425 130.450 130.825 131.125 131.425 131.450 131.475 131.525 131.550 131.650 131.725 131.825 131.850

# ── VDL2 (host ka9q R2 → dumpvdl2; RTL 129 unused) ──────────────────────────
VDL2_RTL_SERIAL=129
VDL2_SOAPYSDR=
VDL2_GAIN=32.0
VDL2_FREQUENCIES=136100000 136300000 136650000 136700000 136725000 136750000 136775000 136800000 136825000 136850000 136875000 136900000 136925000 136950000 136975000

# ── HFDL (parked docker / HF+ path; live is host RX888) ─────────────────────
HFDL_SOAPYSDR=driver=airspyhf,serial=2f52ff5de72635e8
HFDL_GAIN_TYPE=--gain-elements
HFDL_GAIN=IFGR=45,RFGR=2
HFDL_SAMPLERATE=768000

# ── AIS ─────────────────────────────────────────────────────────────────────
AIS_RTL_SERIAL=162
AIS_GAIN=auto
AIS_BANDWIDTH=192K
AIS_PORT=8090
AIRFRAMES_AIS_ID=WP-KMCO-AIS
# Aggregators assign per-station hosts/ports — fill locally, do not publish
MARINETRAFFIC_UDP_PORT=
MYSHIPTRACKING_UDP_PORT=
SHIPXPLORER_UDP_PORT=
VESSELFINDER_UDP_PORT=
AISHUB_UDP_PORT=

# ── Radiosonde ──────────────────────────────────────────────────────────────
RADIOSONDE_RTL_SERIAL=402
RADIOSONDE_CALLSIGN=WP-KMCO-SONDE
RADIOSONDE_PORT=5000
ACARS_BIAS=0
VDL2_BIAS=0

DB_SAVE_DAYS=30
DB_ALERT_SAVE_DAYS=180
VDL2_OVERSAMPLE=20
DUMP_HFDL_COMMAND_EXTRA=--fft-threads 12
IRDM_EXTRACTOR_ARGS= -D 8 --multi-frame -d 16 -q 1000 -b 2000
IRDM_PARSER_ARGS= --harder --uw-ec --stats
MAX_GLOBE_HISTORY=365
