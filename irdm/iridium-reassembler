#!/command/with-contenv bash
#shellcheck shell=bash
# WP-KMCO override: same as the image script, but -m libacars so FANS
# ADS-C / CPDLC inside Iridium ACARS is unpacked. Requires libacars-2.so
# (bookworm build in irdm/lib/, mounted at /usr/local/lib).

if [[ -n $STATION_ID ]]; then
    REASSEMBLER_ACARS_EXTRA=" --station $STATION_ID"
    MODE_ACARS_LOG="/opt/logs/acars.log"

    export LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export IRDM_HUB="${IRDM_HUB:-acars_router:5558}"

    # Airframes still gets toolkit JSON. Hub copy is flattened in irdm-to-hub.py.
    pypy3 -u /opt/iridium-toolkit/reassembler.py \
        -i zmq: -m libacars -a json ${REASSEMBLER_EXTRA} ${REASSEMBLER_ACARS_EXTRA} \
        | tee "$MODE_ACARS_LOG" \
        | python3 -u /opt/irdm-to-hub.py \
        | /opt/iridium-toolkit/iridium-acars-to-airframes.py -d
else
    echo "No station ID"
    sleep infinity
    exit 0
fi
