#!/command/with-contenv bash
# shellcheck shell=bash
# WP-KMCO: replace rust acars-bridge with libacars enricher (same UDP hop).
# acarsdec still emits json:udp to 127.0.0.1:5550; we unpack FANS and forward
# to OUTPUT_SERVER:OUTPUT_SERVER_PORT (acars_router:5550).

SCRIPT_NAME="$(basename "$0")"
SCRIPT_NAME="${SCRIPT_NAME%.*}"
s6wrap=(s6wrap --quiet --timestamps --prepend="$SCRIPT_NAME" --args)

if [[ -n "$SERVER" ]]; then
    OUTPUT_SERVER="$SERVER"
fi
if [[ -n "$SERVER_PORT" ]]; then
    OUTPUT_SERVER_PORT="$SERVER_PORT"
fi

OUTPUT_SERVER="${OUTPUT_SERVER:-acars_router}"
OUTPUT_SERVER_PORT="${OUTPUT_SERVER_PORT:-5550}"
export LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

"${s6wrap[@]}" echo "[INFO] Starting libacars-enrich 0.0.0.0:5550 -> ${OUTPUT_SERVER}:${OUTPUT_SERVER_PORT}"
exec "${s6wrap[@]}" python3 -u /opt/libacars-enrich.py \
    --listen 0.0.0.0:5550 \
    --forward "${OUTPUT_SERVER}:${OUTPUT_SERVER_PORT}"
