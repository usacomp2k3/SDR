[Unit]
Description=WP-KMCO RX888mk2 ka9q-radio (HFDL front end)
Documentation=file:///home/station/acars-hub/rx888/README.md
After=network-online.target usbfs-memory.service docker.service rx888-firmware.service lo-multicast.service
Wants=network-online.target usbfs-memory.service lo-multicast.service

[Service]
Type=simple
User=station
Group=station
WorkingDirectory=/home/station/acars-hub/rx888
Environment=LD_LIBRARY_PATH=/home/station/acars-hub/rx888/opt/lib
Environment=PATH=/home/station/acars-hub/rx888/opt/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/home/station/acars-hub/rx888/wait-rx888.sh
ExecStartPre=+/bin/sh -c '/usr/bin/docker inspect dumphfdl >/dev/null 2>&1 && /usr/bin/docker update --restart=no dumphfdl && /usr/bin/docker stop dumphfdl || true'
ExecStart=/home/station/acars-hub/rx888/run-radiod.sh
Restart=always
RestartSec=5
Nice=-5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
