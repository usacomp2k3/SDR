[Unit]
Description=WP-KMCO VHF decode (acarsdec + dumpvdl2)
Documentation=file:///home/station/acars-hub/vhf-r2/README.md
After=vhf-r2-radiod.service docker.service
Requires=vhf-r2-radiod.service
Wants=docker.service

[Service]
Type=simple
User=station
Group=station
WorkingDirectory=/home/station/acars-hub/vhf-r2
Environment=LD_LIBRARY_PATH=/home/station/acars-hub/rx888/opt/lib
Environment=PATH=/home/station/acars-hub/rx888/opt/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /home/station/acars-hub/vhf-r2/run-decode.sh
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
